\par \hich\af31506\dbch\af31505\loch\f31506                 ['user_id' => $u->id],
\par \hich\af31506\dbch\af31505\loch\f31506                 ['score' => round($rank[$u->id], 6), 'computed_at' => now()]
\par \hich\af31506\dbch\af31505\loch\f31506             );
