\par \hich\af31506\dbch\af31505\loch\f31506     private function computeScore(User $mentor, array \hich\af31506\dbch\af31505\loch\f31506 $learnerAvail): float \{
\par \hich\af31506\dbch\af31505\loch\f31506         $R   = $mentor->trustScore?->score ?? 0;
\par \hich\af31506\dbch\af31505\loch\f31506         $E   = min($mentor->profile->experience_years / 10, 1.0);
\par \hich\af31506\dbch\af31505\loch\f31506         $A   = $this->availabilityOverlap($mentor->availability, $learnerAvail);
\par \hich\af31506\dbch\af31505\loch\f31506         $Rsp = $mentor->\hich\af31506\dbch\af31505\loch\f31506 profile->response_rate;
\par 
\par \hich\af31506\dbch\af31505\loch\f31506         return 0.30*$R + 0.25*$E + 0.20*$A + 0.10*$Rsp;
\par \hich\af31506\dbch\af31505\loch\f31506     \}
