\par \hich\af31506\dbch\af31505\loch\f31506                 \}
\par \hich\af31506\dbch\af31505\loch\f31506                 $newRank[$u->id] = (1 - $damping) / $n + $damping * $inflow;
\par \hich\af31506\dbch\af31505\loch\f31506             \}
\par \hich\af31506\dbch\af31505\loch\f31506             $rank = $newRank;
\par \hich\af31506\dbch\af31505\loch\f31506         \}
