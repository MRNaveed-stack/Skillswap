\par \hich\af31506\dbch\af31505\loch\f31506             foreach ($learnerSlots as $ls) \{
\par \hich\af31506\dbch\af31505\loch\f31506                 $overlap += max(0, min($ms->end, $ls['end']) - max($ms->start, $ls['start']));
\par \hich\af31506\dbch\af31505\loch\f31506             \}
