\par \hich\af31506\dbch\af31505\loch\f31506     private function availabilityOverlap($mentorSlots, array $learnerSlots): float \{
\par \hich\af31506\dbch\af31505\loch\f31506         $overlap = 0;
\par \hich\af31506\dbch\af31505\loch\f31506         $total   = array_sum(array_column(\hich\af31506\dbch\af31505\loch\f31506 $learnerSlots, 'duration'));
