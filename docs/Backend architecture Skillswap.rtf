\par \hich\af31506\dbch\af31505\loch\f31506         foreach ($requests as $r) \{
\par \hich\af31506\dbch\af31505\loch\f31506             if ($r['start'] >= $lastEnd + $gapMinutes) \{
\par \hich\af31506\dbch\af31505\loch\f31506                 $scheduled[] = $r;
\par \hich\af31506\dbch\af31505\loch\f31506                 $lastEnd = $r['end'];
\par \hich\af31506\dbch\af31505\loch\f31506             \}
\par \hich\af31506\dbch\af31505\loch\f31506         \}
\par \hich\af31506\dbch\af31505\loch\f31506         \hich\af31506\dbch\af31505\loch\f31506 return $scheduled;
