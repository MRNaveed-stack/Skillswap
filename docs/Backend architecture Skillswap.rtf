\par \hich\af31506\dbch\af31505\loch\f31506     public function greedySchedule(array $requests, int $gapMinutes = 10): array \{
\par \hich\af31506\dbch\af31505\loch\f31506         usort($requests, fn($a, $b) => $a['end'] <=> $b['end']);
\par \hich\af31506\dbch\af31505\loch\f31506         \hich\af31506\dbch\af31505\loch\f31506 $scheduled = [];
