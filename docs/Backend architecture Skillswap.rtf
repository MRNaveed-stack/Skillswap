\par \hich\af31506\dbch\af31505\loch\f31506     // PageRank-style pass \hich\f31506 \emdash \loch\f31506  called from nightly Artisan command
\par \hich\af31506\dbch\af31505\loch\f31506     public function recompute(float $damping = 0.85, int $iterations = 20): void \{
\par \hich\af31506\dbch\af31505\loch\f31506         $users = User::with('reviews')->get();
\par \hich\af31506\dbch\af31505\loch\f31506         $n     = \hich\af31506\dbch\af31505\loch\f31506 $users->count();
\par \hich\af31506\dbch\af31505\loch\f31506         $rank  = $users->mapWithKeys(fn($u) => [$u->id => 1 / $n])->toArray();
\par 
\par \hich\af31506\dbch\af31505\loch\f31506         for ($iter = 0; $iter < $iterations; $iter++) \{
\par \hich\af31506\dbch\af31505\loch\f31506             $newRank = [];
\par \hich\af31506\dbch\af31505\loch\f31506             foreach ($users as $u) \{
