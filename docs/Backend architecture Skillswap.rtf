\par \hich\af31506\dbch\af31505\loch\f31506     // DP: maximise credit value \hich\f31506 \emdash \loch\f31506  used in nightly batch
\par \hich\af31506\dbch\af31505\loch\f31506     public function dpSchedule(array $requests, int $gapMinutes = 10): array \{
\par \hich\af31506\dbch\af31505\loch\f31506         usort($requests, fn($a, $b) => $a['end'] <=> $b['end']);
\par \hich\af31506\dbch\af31505\loch\f31506         $n  = count(\hich\af31506\dbch\af31505\loch\f31506 $requests);
\par \hich\af31506\dbch\af31505\loch\f31506         if ($n === 0) return [];
\par 
\par \hich\af31506\dbch\af31505\loch\f31506         $p = array_fill(0, $n, -1);
\par \hich\af31506\dbch\af31505\loch\f31506         for ($i = 0; $i < $n; $i++) \{
\par \hich\af31506\dbch\af31505\loch\f31506             $lo = 0; $hi = $i - 1;
\par \hich\af31506\dbch\af31505\loch\f31506             while ($lo <= $hi) \{
\par \hich\af31506\dbch\af31505\loch\f31506                 $mid = ($lo + $hi) >> 1;
\par \hich\af31506\dbch\af31505\loch\f31506                 if (\hich\af31506\dbch\af31505\loch\f31506 $requests[$mid]['end'] <= $requests[$i]['start'] - $gapMinutes) \{
\par \hich\af31506\dbch\af31505\loch\f31506                     $p[$i] = $mid; $lo = $mid + 1;
\par \hich\af31506\dbch\af31505\loch\f31506                 \} else \{ $hi = $mid - 1; \}
\par \hich\af31506\dbch\af31505\loch\f31506             \}
\par \hich\af31506\dbch\af31505\loch\f31506         \}
\par 
\par \hich\af31506\dbch\af31505\loch\f31506         $dp = array_fill(0, $n + 1, 0);
\par \hich\af31506\dbch\af31505\loch\f31506         for ($i = 0; $i < $n; \hich\af31506\dbch\af31505\loch\f31506 $i++) \{
\par \hich\af31506\dbch\af31505\loch\f31506             $include  = $requests[$i]['value'] + ($p[$i] >= 0 ? $dp[$p[$i] + 1] : 0);
\par \hich\af31506\dbch\af31505\loch\f31506             $dp[$i+1] = max($dp[$i], $include);
\par \hich\af31506\dbch\af31505\loch\f31506         \}
\par 
\par \hich\af31506\dbch\af31505\loch\f31506         $picked = [];
\par \hich\af31506\dbch\af31505\loch\f31506         $i = $n - 1;
\par \hich\af31506\dbch\af31505\loch\f31506         while ($i >= 0) \{
\par \hich\af31506\dbch\af31505\loch\f31506             $include = \hich\af31506\dbch\af31505\loch\f31506 $requests[$i]['value'] + ($p[$i] >= 0 ? $dp[$p[$i]+1] : 0);
\par \hich\af31506\dbch\af31505\loch\f31506             if ($include >= $dp[$i]) \{ array_unshift($picked, $requests[$i]); $i = $p[$i]; \}
\par \hich\af31506\dbch\af31505\loch\f31506             else $i--;
\par \hich\af31506\dbch\af31505\loch\f31506         \}
\par \hich\af31506\dbch\af31505\loch\f31506         return $picked;
\par \hich\af31506\dbch\af31505\loch\f31506     \}
