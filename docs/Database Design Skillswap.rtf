-- =============================================================
\par \hich\af31506\dbch\af31505\loch\f31506 --  SkillSwap \hich\f31506 \emdash \loch\f31506  PostgreSQL Schema
\par \hich\af31506\dbch\af31505\loch\f31506 --  Normalization: 3NF throughout; selective denormalization
\par \hich\af31506\dbch\af31505\loch\f31506 --  noted inline where a cache column trades writes for reads.
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- Enable pgcrypto for gen_random_uuid()
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE EXTENSION IF NOT EXISTS pgcrypto;
\par 
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par \hich\af31506\dbch\af31505\loch\f31506 --  DOMAIN: USERS & AUTHENTICATION
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE users (
\par \hich\af31506\dbch\af31505\loch\f31506     id               UUID          PRIMARY KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     email            VARCHAR(255)  NOT\hich\af31506\dbch\af31505\loch\f31506  NULL UNIQUE,
\par \hich\af31506\dbch\af31505\loch\f31506     password_hash    VARCHAR(255)  NOT NULL,
\par \hich\af31506\dbch\af31505\loch\f31506     email_verified_at TIMESTAMPTZ,
\par \hich\af31506\dbch\af31505\loch\f31506     role             VARCHAR(20)   NOT NULL DEFAULT 'user'
\par \hich\af31506\dbch\af31505\loch\f31506                          CHECK (role IN ('user', 'admin')),
\par \hich\af31506\dbch\af31505\loch\f31506     is_active        BOOLEAN       NOT NULL DEFAULT TRUE,
\par \hich\af31506\dbch\af31505\loch\f31506     created_at       TIMESTAMPTZ   NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     updated_at       TIMESTAMPTZ   NOT NULL DEFAULT NOW()
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- Normalization note: profile data separated from auth data (SRP).
\par \hich\af31506\dbch\af31505\loch\f31506 -- One-to-one enforced by UNIQUE on user_id.
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE profiles (
\par \hich\af31506\dbch\af31505\loch\f31506     id                           UUID         PRIMARY KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     user_id                      UUID         NOT NULL UNIQUE
\par \hich\af31506\dbch\af31505\loch\f31506                                                   REFERENCES users(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     full_name                    VARCHAR(100) NOT NULL,
\par \hich\af31506\dbch\af31505\loch\f31506     bio                          TEXT,
\par \hich\af31506\dbch\af31505\loch\f31506     avatar_url                   VARCHAR(50\hich\af31506\dbch\af31505\loch\f31506 0),
\par \hich\af31506\dbch\af31505\loch\f31506     timezone                     VARCHAR(50)  NOT NULL DEFAULT 'UTC',
\par \hich\af31506\dbch\af31505\loch\f31506     -- Denormalized cache columns (recomputed on session completion)
\par \hich\af31506\dbch\af31505\loch\f31506     -- Avoids expensive SUM(transactions) on every profile view.
\par \hich\af31506\dbch\af31505\loch\f31506     total_credits_earned         NUMERIC(12,2) NOT NULL DEFAULT 0,
\par \hich\af31506\dbch\af31505\loch\f31506     total_credits_spent          NUMERIC(12,2) NOT NULL DEFAULT 0,
\par \hich\af31506\dbch\af31505\loch\f31506     response_rate                NUMERIC(5,2),   -- mentor response %, cached
\par \hich\af31506\dbch\af31505\loch\f31506     sessions_completed_as_mentor INTEGER       NOT NULL DEFAULT 0,
\par \hich\af31506\dbch\af31505\loch\f31506     sessions_completed_as\hich\af31506\dbch\af31505\loch\f31506 _learner INTEGER      NOT NULL DEFAULT 0,
\par \hich\af31506\dbch\af31505\loch\f31506     created_at                   TIMESTAMPTZ   NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     updated_at                   TIMESTAMPTZ   NOT NULL DEFAULT NOW()
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par \hich\af31506\dbch\af31505\loch\f31506 --  DOMAIN: SKILLS & MARKETPLACE
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- Normalized category lookup; avoids repeating category strings in skills.
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE skill_categories (
\par \hich\af31506\dbch\af31505\loch\f31506     id         SERIAL       PRIMARY KEY,
\par \hich\af31506\dbch\af31505\loch\f31506     name       VARCHAR(100) NOT NULL UNIQUE,
\par \hich\af31506\dbch\af31505\loch\f31506     slug       VARCHAR(100) NOT NULL UNIQUE,
\par \hich\af31506\dbch\af31505\loch\f31506     created_at TIMESTAMPTZ  NOT NULL DEFAULT NOW()
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE skills (
\par \hich\af31506\dbch\af31505\loch\f31506     id          UUID         PRIMARY KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     category_id INTEGER      NOT NULL REFERENCES skill_categories(id),
\par \hich\af31506\dbch\af31505\loch\f31506     title       VARCHAR(150) NOT NULL,
\par \hich\af31506\dbch\af31505\loch\f31506     description TEXT,
\par \hich\af31506\dbch\af31505\loch\f31506     -- Unique slug enables SEO-friendly URLs without full-text search on title.
\par \hich\af31506\dbch\af31505\loch\f31506     slug        VARCHAR(200) NOT NULL UNIQUE,
\par \hich\af31506\dbch\af31505\loch\f31506     is_active   BOO\hich\af31506\dbch\af31505\loch\f31506 LEAN      NOT NULL DEFAULT TRUE,
\par \hich\af31506\dbch\af31505\loch\f31506     created_at  TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     updated_at  TIMESTAMPTZ  NOT NULL DEFAULT NOW()
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- Junction between users (as mentors) and skills.
\par \hich\af31506\dbch\af31505\loch\f31506 -- Stores mentor-specific metadata per skill (experience, price).
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE user_skills (
\par \hich\af31506\dbch\af31505\loch\f31506     id               UUID         PRIMARY KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     user_id          UUID         NOT NULL REFERENCES users(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     skill_id         UUID         NOT NULL REFERENCES skills(id) ON DE\hich\af31506\dbch\af31505\loch\f31506 LETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     experience_level VARCHAR(20)  NOT NULL DEFAULT 'intermediate'
\par \hich\af31506\dbch\af31505\loch\f31506                          CHECK (experience_level IN ('beginner','intermediate','advanced','expert')),
\par \hich\af31506\dbch\af31505\loch\f31506     credits_per_hour NUMERIC(6,2) NOT NULL DEFAULT 1.00
\par \hich\af31506\dbch\af31505\loch\f31506                          CHECK (credits_per_hour > 0),
\par \hich\af31506\dbch\af31505\loch\f31506     description      TEXT,
\par \hich\af31506\dbch\af31505\loch\f31506     is_active        BOOLEAN      NOT NULL DEFAULT TRUE,
\par \hich\af31506\dbch\af31505\loch\f31506     created_at       TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     updated_at       TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     -- One active listing per (user, skill) pair.
\par \hich\af31506\dbch\af31505\loch\f31506     UNIQUE (user_id, skill_id)
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- User interest tags for the recommendation engine.
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE user_interests (
\par \hich\af31506\dbch\af31505\loch\f31506     user_id    UUID        NOT NULL REFERENCES users(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     skill_id   UUID        NOT NULL REFERENCES skills(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     PRIMARY KEY (user_id, skill_id)
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- ======================================\hich\af31506\dbch\af31505\loch\f31506 =======================
\par \hich\af31506\dbch\af31505\loch\f31506 --  DOMAIN: AVAILABILITY & SCHEDULING
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- Recurring weekly availability windows.
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE availability_slots (
\par \hich\af31506\dbch\af31505\loch\f31506     id           UUID        PRIMARY KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     user_id      UUID        NOT NULL REFERENCES users(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     day_of_week  SMALLINT    NOT NULL CHECK (day_of_week BETWEEN 0 AND 6), -- 0=Sunday
\par \hich\af31506\dbch\af31505\loch\f31506     start_time   TIME        NOT NULL,
\par \hich\af31506\dbch\af31505\loch\f31506     end_time     TIME        NOT NUL\hich\af31506\dbch\af31505\loch\f31506 L,
\par \hich\af31506\dbch\af31505\loch\f31506     is_recurring BOOLEAN     NOT NULL DEFAULT TRUE,
\par \hich\af31506\dbch\af31505\loch\f31506     valid_from   DATE,
\par \hich\af31506\dbch\af31505\loch\f31506     valid_until  DATE,
\par \hich\af31506\dbch\af31505\loch\f31506     created_at   TIMESTAMPTZ NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     CONSTRAINT chk_slot_window  CHECK (end_time > start_time),
\par \hich\af31506\dbch\af31505\loch\f31506     CONSTRAINT chk_slot_dates   CHECK (valid_until IS NULL OR valid_until >= valid_from)
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- Session requests raised by learners.
\par \hich\af31506\dbch\af31505\loch\f31506 -- Decoupled from sessions; not every request becomes a session.
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE session_requests (
\par \hich\af31506\dbch\af31505\loch\f31506     id                UUID         PRIMARY KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     learner_id        UUID         NOT NULL REFERENCES users(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     mentor_id         UUID         NOT NULL REFERENCES users(\hich\af31506\dbch\af31505\loch\f31506 id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     user_skill_id     UUID         NOT NULL REFERENCES user_skills(id),
\par \hich\af31506\dbch\af31505\loch\f31506     proposed_start    TIMESTAMPTZ  NOT NULL,
\par \hich\af31506\dbch\af31505\loch\f31506     proposed_end      TIMESTAMPTZ  NOT NULL,
\par \hich\af31506\dbch\af31505\loch\f31506     learner_message   TEXT,
\par \hich\af31506\dbch\af31505\loch\f31506     status            VARCHAR(20)  NOT NULL DEFAULT 'pending'
\par \hich\af31506\dbch\af31505\loch\f31506                           CHECK (status IN ('pending','accepted','rejected','cancelled','expired')),
\par \hich\af31506\dbch\af31505\loch\f31506     credits_reserved  NUMERIC(8,2),   -- held in wallet on request
\par \hich\af31506\dbch\af31505\loch\f31506     rejection_reason  TEXT,
\par \hich\af31506\dbch\af31505\loch\f31506     created_at        TIMESTAMPTZ  NOT NU\hich\af31506\dbch\af31505\loch\f31506 LL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     updated_at        TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     CONSTRAINT chk_request_no_self CHECK (learner_id <> mentor_id),
\par \hich\af31506\dbch\af31505\loch\f31506     CONSTRAINT chk_request_times   CHECK (proposed_end > proposed_start)
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- Confirmed sessions (created from accepted session_requests).
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE sessions (
\par \hich\af31506\dbch\af31505\loch\f31506     id               UUID         PRIMARY KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     -- One session per request (1:1 enforced by UNIQUE).
\par \hich\af31506\dbch\af31505\loch\f31506     request_id       UUID         NOT NULL UNIQUE REFERENCES session_requests(id),
\par \hich\af31506\dbch\af31505\loch\f31506     learner_id       UUID         NOT NULL REFERENCES users(id),
\par \hich\af31506\dbch\af31505\loch\f31506     mentor_id        UUID         NOT NULL REFERENCES users(id),
\par \hich\af31506\dbch\af31505\loch\f31506     user_skill_id    UUID         NOT NULL REFERENCES user_skills(id),
\par \hich\af31506\dbch\af31505\loch\f31506     scheduled_start  TIMESTAMPTZ  NOT NULL,
\par \hich\af31506\dbch\af31505\loch\f31506     scheduled_end    TIMESTAMPTZ  NOT NULL,
\par \hich\af31506\dbch\af31505\loch\f31506     actual_start     TIMESTAMPTZ,
\par \hich\af31506\dbch\af31505\loch\f31506     actual_end       TIMESTAMPTZ,
\par \hich\af31506\dbch\af31505\loch\f31506     status           VARCHAR(20)  NOT NULL DEFAULT 'scheduled'
\par \hich\af31506\dbch\af31505\loch\f31506          \hich\af31506\dbch\af31505\loch\f31506                 CHECK (status IN ('scheduled','in_progress','completed','cancelled','no_show')),
\par \hich\af31506\dbch\af31505\loch\f31506     credits_charged  NUMERIC(8,2),
\par \hich\af31506\dbch\af31505\loch\f31506     meeting_url      VARCHAR(500),
\par \hich\af31506\dbch\af31505\loch\f31506     notes            TEXT,
\par \hich\af31506\dbch\af31505\loch\f31506     created_at       TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     updated_at       TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     CONSTRAINT chk_session_times CHECK (scheduled_end > scheduled_start)
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par \hich\af31506\dbch\af31505\loch\f31506 --  DOMAIN: CREDIT WALLET
\par \hich\af31506\dbch\af31505\loch\f31506 -- ==============================\hich\af31506\dbch\af31505\loch\f31506 ===============================
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- One wallet per user. Balance enforced non-negative at DB level.
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE wallets (
\par \hich\af31506\dbch\af31505\loch\f31506     id           UUID         PRIMARY KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     user_id      UUID         NOT NULL UNIQUE REFERENCES users(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     balance      NUMERIC(12,2) NOT NULL DEFAULT 10.00,  -- signup bonus
\par \hich\af31506\dbch\af31505\loch\f31506     total_earned NUMERIC(12,2) NOT NULL DEFAULT 0,
\par \hich\af31506\dbch\af31505\loch\f31506     total_spent  NUMERIC(12,2) NOT NULL DEFAULT 0,
\par \hich\af31506\dbch\af31505\loch\f31506     created_at   TIMESTAMPTZ   NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     updated_at   TIMESTAMPTZ   NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     CONSTRAINT chk_wallet_balance     CHECK (balance >= 0),
\par \hich\af31506\dbch\af31505\loch\f31506     CONSTRAINT chk_wallet_earned      CHECK (total_earned >= 0),
\par \hich\af31506\dbch\af31505\loch\f31506     CONSTRAINT chk_wallet_spent       CHECK (total_spent >= 0)
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- Append-only ledger. Never update or delete rows; only INSERT.
\par \hich\af31506\dbch\af31505\loch\f31506 -- balance_after is denormalized for O(1) current-balance reads from history.
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE transactions (
\par \hich\af31506\dbch\af31505\loch\f31506     id            UUID         PRIMARY \hich\af31506\dbch\af31505\loch\f31506 KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     wallet_id     UUID         NOT NULL REFERENCES wallets(id),
\par \hich\af31506\dbch\af31505\loch\f31506     session_id    UUID                     REFERENCES sessions(id),
\par \hich\af31506\dbch\af31505\loch\f31506     type          VARCHAR(30)  NOT NULL
\par \hich\af31506\dbch\af31505\loch\f31506                       CHECK (type IN (
\par \hich\af31506\dbch\af31505\loch\f31506                           'credit_earned','credit_spent',
\par \hich\af31506\dbch\af31505\loch\f31506                           'refund','signup_bonus','adjustment','credit_reserved','credit_released'
\par \hich\af31506\dbch\af31505\loch\f31506                       )),
\par \hich\af31506\dbch\af31505\loch\f31506     -- Positive = money in, negative = money out.
\par \hich\af31506\dbch\af31505\loch\f31506     amount        NUMERIC(10,2) NOT N\hich\af31506\dbch\af31505\loch\f31506 ULL,
\par \hich\af31506\dbch\af31505\loch\f31506     balance_after NUMERIC(12,2) NOT NULL,
\par \hich\af31506\dbch\af31505\loch\f31506     description   VARCHAR(255),
\par \hich\af31506\dbch\af31505\loch\f31506     created_at    TIMESTAMPTZ  NOT NULL DEFAULT NOW()
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par \hich\af31506\dbch\af31505\loch\f31506 --  DOMAIN: MESSAGING
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE conversations (
\par \hich\af31506\dbch\af31505\loch\f31506     id                  UUID        PRIMARY KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     session_request_id  UUID                    REFERENCES session_requests(id),
\par \hich\af31506\dbch\af31505\loch\f31506     last_message_at     TIMESTAMPTZ,            -- denormalized for inbox sort
\par \hich\af31506\dbch\af31505\loch\f31506     created_at          TIMESTAMPTZ NOT NULL DEFAULT NOW()
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- Many-to-many: one conversation can have multiple participants.
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE conversation_participants (
\par \hich\af31506\dbch\af31505\loch\f31506     conversa\hich\af31506\dbch\af31505\loch\f31506 tion_id UUID        NOT NULL REFERENCES conversations(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     user_id         UUID        NOT NULL REFERENCES users(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     joined_at       TIMESTAMPTZ NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     last_read_at    TIMESTAMPTZ,
\par \hich\af31506\dbch\af31505\loch\f31506     PRIMARY KEY (conversation_id, user_id)
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE messages (
\par \hich\af31506\dbch\af31505\loch\f31506     id              UUID        PRIMARY KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     conversation_id UUID        NOT NULL REFERENCES conversations(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     sender_id       UUID        NO\hich\af31506\dbch\af31505\loch\f31506 T NULL REFERENCES users(id),
\par \hich\af31506\dbch\af31505\loch\f31506     content         TEXT        NOT NULL,
\par \hich\af31506\dbch\af31505\loch\f31506     is_edited       BOOLEAN     NOT NULL DEFAULT FALSE,
\par \hich\af31506\dbch\af31505\loch\f31506     created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     updated_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par \hich\af31506\dbch\af31505\loch\f31506 --  DOMAIN: REPUTATION & RANKING
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 \hich\f31506 -- Post-session reviews. Both learner\u8594\'3f\loch\f31506 \hich\f31506 mentor and mentor\u8594\'3f\loch\f31506 learner allowed.
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE reviews (
\par \hich\af31506\dbch\af31505\loch\f31506     id          UUID       PRIMARY KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     session_id  UUID       NOT NULL REFERENCES sessions(id),
\par \hich\af31506\dbch\af31505\loch\f31506     reviewer_id UUID       NOT NULL REFERENCES users(id),
\par \hich\af31506\dbch\af31505\loch\f31506     reviewee_id UUID       NOT NULL REFERENCES users(id),
\par \hich\af31506\dbch\af31505\loch\f31506     ratin\hich\af31506\dbch\af31505\loch\f31506 g      SMALLINT   NOT NULL CHECK (rating BETWEEN 1 AND 5),
\par \hich\af31506\dbch\af31505\loch\f31506     comment     TEXT,
\par \hich\af31506\dbch\af31505\loch\f31506     created_at  TIMESTAMPTZ NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     -- One review per direction per session.
\par \hich\af31506\dbch\af31505\loch\f31506     UNIQUE (session_id, reviewer_id),
\par \hich\af31506\dbch\af31505\loch\f31506     CONSTRAINT chk_review_no_self CHECK (reviewer_id <> reviewee_id)
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- Materialized PageRank-style trust scores. Recomputed by a background job.
\par \hich\af31506\dbch\af31505\loch\f31506 -- Stored separately from profiles to allow versioned re-runs.
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE trust_scores (
\par \hich\af31506\dbch\af31505\loch\f31506     id                UUID         PRIMARY KEY DEFAULT \hich\af31506\dbch\af31505\loch\f31506 gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     user_id           UUID         NOT NULL UNIQUE REFERENCES users(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     score             NUMERIC(10,8) NOT NULL DEFAULT 0.15000000, -- PageRank init
\par \hich\af31506\dbch\af31505\loch\f31506     rank_position     INTEGER,
\par \hich\af31506\dbch\af31505\loch\f31506     total_reviews     INTEGER      NOT NULL DEFAULT 0,
\par \hich\af31506\dbch\af31505\loch\f31506     average_rating    NUMERIC(3,2),
\par \hich\af31506\dbch\af31505\loch\f31506     algorithm_version SMALLINT     NOT NULL DEFAULT 1,
\par \hich\af31506\dbch\af31505\loch\f31506     last_computed_at  TIMESTAMPTZ,
\par \hich\af31506\dbch\af31505\loch\f31506     created_at        TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     updated_at        TIMESTAMPTZ  NOT NULL DEFAULT NOW()
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- Graph edge table used by the PageRank computation.
\par \hich\af31506\dbch\af31505\loch\f31506 -- Represents trust relationships between users derived from reviews.
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE trust_edges (
\par \hich\af31506\dbch\af31505\loch\f31506     from_user_id UUID        NOT NULL REFERENCES users(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     to_user_id   UUID        NOT NULL REFERENCES users(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     weight       NUMERIC(6,4) NOT NULL DEFAULT 1.0,  -- aggregated normalized rating
\par \hich\af31506\dbch\af31505\loch\f31506     review_count INTEGER     NOT NULL DEFAULT 1,
\par \hich\af31506\dbch\af31505\loch\f31506     updated_at   TIMESTAMPTZ NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     PRIMARY KEY (from_user_id, to_user_id),
\par \hich\af31506\dbch\af31505\loch\f31506     CONSTRAINT chk_edge_no_self CHECK (from_user_id <> to_user_id)
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par \hich\af31506\dbch\af31505\loch\f31506 --  DOMAIN: RECOMMENDATIONS
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- Precomputed recommendation scores; refreshed periodically.
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE skill_recommendations (
\par \hich\af31506\dbch\af31505\loch\f31506     id         UUID         PRIMARY\hich\af31506\dbch\af31505\loch\f31506  KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     user_id    UUID         NOT NULL REFERENCES users(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     skill_id   UUID         NOT NULL REFERENCES skills(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     score      NUMERIC(8,6) NOT NULL,
\par \hich\af31506\dbch\af31505\loch\f31506     reason     VARCHAR(30)  NOT NULL
\par \hich\af31506\dbch\af31505\loch\f31506                    CHECK (reason IN ('collaborative_filter','popularity','similar_users','trending')),
\par \hich\af31506\dbch\af31505\loch\f31506     created_at TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     UNIQUE (user_id, skill_id)
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE mentor_recommendations (
\par \hich\af31506\dbch\af31505\loch\f31506     id            UUID         PRIMARY KEY DEFAULT gen_random_uuid(),
\par \hich\af31506\dbch\af31505\loch\f31506     learner_id    UUID         NOT NULL REFERENCES users(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     user_skill_id UUID         NOT NULL REFERENCES user_skills(id) ON DELETE CASCADE,
\par \hich\af31506\dbch\af31505\loch\f31506     score         NUMERIC(8,6) NOT NULL,
\par \hich\af31506\dbch\af31505\loch\f31506     reason        VARCHAR(30),
\par \hich\af31506\dbch\af31505\loch\f31506     created_at    TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
\par \hich\af31506\dbch\af31505\loch\f31506     UNIQUE (learner_id, user_skill_id)
\par \hich\af31506\dbch\af31505\loch\f31506 );
\par 
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par --\hich\af31506\dbch\af31505\loch\f31506   DOMAIN: NOTIFICATIONS
\par \hich\af31506\dbch\af31505\loch\f31506 -- =============================================================
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 CREATE TABLE notifications (
\par \hich\af31506\dbch\af31505\loch\f31506     id                  UUID        PRIMARY KEY DEFAULT gen_random_uuid(),
