\par \hich\af31506\dbch\af31505\loch\f31506         foreach ($candidates as $mentor) \{
\par \hich\af31506\dbch\af31505\loch\f31506             $score = $this->computeScore($mentor, $learnerAvail);
\par \hich\af31506\dbch\af31505\loch\f31506            \hich\af31506\dbch\af31505\loch\f31506  if ($heap->count() < $topK) \{
\par \hich\af31506\dbch\af31505\loch\f31506                 $heap->insert(['score' => $score, 'mentor' => $mentor]);
\par \hich\af31506\dbch\af31505\loch\f31506             \} elseif ($score > $heap->top()['score']) \{
\par \hich\af31506\dbch\af31505\loch\f31506                 $heap->extract();
\par \hich\af31506\dbch\af31505\loch\f31506                 $heap->insert(['score' => $score, \hich\af31506\dbch\af31505\loch\f31506 'mentor' => $mentor]);
\par \hich\af31506\dbch\af31505\loch\f31506             \}
\par \hich\af31506\dbch\af31505\loch\f31506         \}
\par 
\par \hich\af31506\dbch\af31505\loch\f31506         $results = [];
\par \hich\af31506\dbch\af31505\loch\f31506         while (!$heap->isEmpty()) array_unshift($results, $heap->extract());
\par \hich\af31506\dbch\af31505\loch\f31506         return $results;
\par \hich\af31506\dbch\af31505\loch\f31506     \}
