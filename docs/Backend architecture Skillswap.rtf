\par \hich\af31506\dbch\af31505\loch\f31506     public function getTopMentors(int $skillId, array $learnerAvail, int $topK = 10): array \{
\par \hich\af31506\dbch\af31505\loch\f31506         $candidates = $this->skills->getMentorsBySkill($skillId);
\par \hich\af31506\dbch\af31505\loch\f31506         $heap = new SplMinHeap();
