\par \hich\af31506\dbch\af31505\loch\f31506     body                TEXT,
\par \hich\af31506\dbch\af31505\loch\f31506     is_read             BOOLEAN     NOT NULL DEFAULT FALSE,
\par \hich\af31506\dbch\af31505\loch\f31506     --\hich\af31506\dbch\af31505\loch\f31506  Polymorphic reference (no FK; resolved by application layer).
\par \hich\af31506\dbch\af31505\loch\f31506     related_entity_type VARCHAR(50),
\par \hich\af31506\dbch\af31505\loch\f31506     related_entity_id   UUID,
